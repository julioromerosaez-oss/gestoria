# Copia este fichero a .env y rellénalo. NUNCA lo subas a git.

# Dominio público (Nginx sirve https://DOMINIO)
DOMINIO=gestoria.tudominio.es

# --- Login propio de la API (no se usa Supabase Auth) ---
# Genera una con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Supabase: proyecto "Genia" (exvvvmwdxlitsvomgbfm) ---
SUPABASE_URL=https://exvvvmwdxlitsvomgbfm.supabase.co
# SECRETA (Dashboard > Project Settings > API keys > service_role / secret).
# Solo la usa el backend para el bucket privado "gestoria-facturas".
SUPABASE_SERVICE_ROLE_KEY=

# Base de datos con el rol dedicado gestoria_api (contraseña la que pongas con ALTER ROLE).
# Copia host y puerto de Dashboard > Connect > "Session pooler" (puerto 5432, NO el 6543).
# El usuario en el pooler es gestoria_api.<ref-del-proyecto>
DATABASE_URL=postgresql+psycopg2://gestoria_api.exvvvmwdxlitsvomgbfm:CONTRASEÑA@HOST-DEL-POOLER:5432/postgres

MAX_UPLOAD_MB=10
