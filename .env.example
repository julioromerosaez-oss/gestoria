# Copia este fichero a .env y rellénalo. NUNCA lo subas a git.

# Dominio público (Nginx sirve https://DOMINIO)
DOMINIO=gestoria.tudominio.es

# --- Login propio de la API (no se usa Supabase Auth) ---
# Genera una con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Supabase: proyecto "gestoria" (fgjoafbpejgrbnjsufvi) ---
SUPABASE_URL=https://fgjoafbpejgrbnjsufvi.supabase.co
# SECRETA. Crea una clave secreta SOLO para la gestoría:
#   Supabase > Settings > API Keys > "Publishable and secret API keys" > nueva secret key "gestoria_backend"
# Empieza por sb_secret_. Solo la usa el backend para el bucket privado "gestoria-facturas".
# (Aún se admite la antigua service_role en SUPABASE_SERVICE_ROLE_KEY, pero caduca a finales de 2026.)
SUPABASE_SECRET_KEY=

# Base de datos con el rol dedicado gestoria_api (contraseña la que pongas con ALTER ROLE).
# Copia host y puerto de Dashboard > Connect > "Session pooler" (puerto 5432, NO el 6543).
# El usuario en el pooler es gestoria_api.<ref-del-proyecto>
DATABASE_URL=postgresql+psycopg2://gestoria_api.fgjoafbpejgrbnjsufvi:CONTRASEÑA@HOST-DEL-POOLER:5432/postgres

MAX_UPLOAD_MB=10
